              "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 175.5,\n  \"description\": \"Supermercado — valor atualizado\",\n  \"date\": \"{{transactionDate}}\",\n  \"categoryId\": \"{{categoryId}}\"\n}",
