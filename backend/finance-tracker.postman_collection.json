    {
      "name": "08 Eventos SSE",
      "description": "Conexão longa; execute separadamente e cancele ao terminar.",
      "item": [
        {
          "name": "Acompanhar eventos da carteira",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{walletId}}",
                "events"
              ]
            },
            "description": "200 text/event-stream, Bearer e usuário membro. ready ao conectar, heartbeat a cada 25 s e transaction-changed após criar/editar/excluir transação em outra requisição. Dura até 5 min; pode ficar pendente no cliente. Ajuste timeout; suporte à exibição incremental depende da versão do Bruno."
          }
        }
