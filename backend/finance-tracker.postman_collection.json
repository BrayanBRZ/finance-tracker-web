              "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 150,\n  \"description\": \"Supermercado — teste Bruno\",\n  \"date\": \"{{transactionDate}}\",\n  \"categoryId\": \"{{categoryId}}\"\n}",
