    {
      "name": "06 Transações",
      "description": "OWNER e EDITOR podem escrever; VIEWER pode consultar. Requer walletId; categoria deve pertencer ao autor e combinar com type.",
      "item": [
        {
          "name": "Criar transação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
